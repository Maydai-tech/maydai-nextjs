# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Airtable Configuration (Optional)
AIRTABLE_API_KEY=your_airtable_api_key
AIRTABLE_BASE_ID=your_airtable_base_id

# CookieYes Configuration (Required for cookie banner)
NEXT_PUBLIC_COOKIEYES_ID=your_cookieyes_id

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key

# Mistral AI (génération de description + agents conversationnels)
MISTRAL_API_KEY=your_mistral_api_key
# Agent Le Chat — cadrage Setup (défaut : ag_01a01a3cde77754c83c3cf55366858d8)
MISTRAL_CONVERSATION_AGENT_ID=ag_01a01a3cde77754c83c3cf55366858d8
# Agent évaluateur AI Act — Chantier 3 (défaut : ag_01a01a725c2a768192011ff9cbed2c8a)
MISTRAL_EVALUATION_AGENT_ID=ag_01a01a725c2a768192011ff9cbed2c8a
# Agent génération rapport AI Act (défaut : ag_01a01a87fd80764da399c641001c764e)
MISTRAL_REPORT_AGENT_ID=ag_01a01a87fd80764da399c641001c764e

# LLM Stats (synchronisation quotidienne Bench LLM via Vercel Cron)
LLM_STATS_API_KEY=your_llm_stats_api_key
LLM_STATS_BASE_URL=https://api.llm-stats.com/stats
CRON_SECRET=your_vercel_cron_secret

# EcoLogits (catalogue et impacts environnementaux — clé optionnelle selon le déploiement API)
ECOLOGITS_BASE_URL=https://api.ecologits.ai
ECOLOGITS_API_KEY=

# Mailjet Configuration
MAILJET_API_KEY=your_mailjet_api_key_public
MAILJET_API_SECRET=your_mailjet_secret_key

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Google Drive — Service Account (lecture Shared Drive / Cadastre documentaire)
# Clé privée : conserver les \n littéraux dans .env (remplacés au runtime)
GOOGLE_DRIVE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Racine du Shared Drive MaydAI (ID type 0A…)
GOOGLE_DRIVE_SHARED_ROOT_ID=0AOTKdfW3U-S5Uk9PVA
# Dossier Cadastre Bench LLM (sous le Shared Drive)
GOOGLE_DRIVE_FOLDER_BENCH_LLM=1rYMrEbiPlmzRyti7h-PLcgoDhlXJYDCv
# Alias legacy (webhook KB) — même valeur que SHARED_ROOT_ID si non migré
# GOOGLE_DRIVE_KB_FOLDER_ID=0AOTKdfW3U-S5Uk9PVA

# Google Ads API — conversions hors ligne (GCLID dans leads.click_id)
GOOGLE_ADS_DEVELOPER_TOKEN=your_google_ads_developer_token
GOOGLE_ADS_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_ADS_REFRESH_TOKEN=your_oauth_refresh_token
# ID client Google Ads (10 chiffres, avec ou sans tirets)
GOOGLE_ADS_CUSTOMER_ID=1234567890
# Compte manager (MCC) utilisé pour l’authentification API — 10 chiffres, avec ou sans tirets (souvent distinct du compte client)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890

# Monitoring admin (optionnel — URLs du serveur prod servant disk.json / email-status.json)
# MONITORING_PROD_DISK_JSON_URL=https://votre-serveur/monitoring/disk.json
# MONITORING_PROD_EMAIL_STATUS_JSON_URL=https://votre-serveur/monitoring/email-status.json
# MONITORING_PROD_DOCKER_PURGES_JSON_URL=https://votre-serveur/monitoring/docker-purges.json
